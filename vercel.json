{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ds/(.*)",
      "destination": "https://api.deepseek.com/$1"
    },
    {
      "source": "/cb/(.*)",
      "destination": "https://codebuddy.cn/$1"
    }
  ],
  "routes": [
    {
      "src": "/oc/(.*)",
      "dest": "https://opencode.ai/zen/go/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-opencode-session" },
          "args": "vercel-proxy"
        }
      ]
    }
  ]
}
